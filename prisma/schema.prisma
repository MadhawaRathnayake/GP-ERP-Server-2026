generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Conventions
// - Model name = table name (no @@map), so `config: { cache: ["Customer"] }` and DB change events use the same names.
// - Every table gets a notify_change trigger from `npm run db:migrate` (cache invalidation). Never use `prisma db push`.
// - Timestamps: @db.Timestamptz(3), stored in UTC. Money: Decimal @db.Decimal(14, 2) + `money` from platform/http/fields.ts.
// - Every table except Session and RolePermission ends with the audit columns, in this order:
//     createdBy · createdAt · modifiedBy · modifiedAt · isDeleted
//   createdBy/modifiedBy are user ids set from the actor, never from clients. NULL = written by the system (boot sync,
//   seed, defaults); only User.createdBy is required. modifiedAt is NULL until the first change. isDeleted = true is a
//   soft delete. Users are never deleted, so `onDelete: SetNull` only matters when a user row is removed by hand (tests).

// ─── Settings ────────────────────────────────────────────────────────────────

// Single-row table (id = 1) holding company-wide business settings. See modules/settings.
model Setting {
  id         Int       @id @default(1)
  currency   String    @db.Char(3) // ISO 4217, e.g. LKR
  country    String    @db.Char(2) // ISO 3166-1 alpha-2, e.g. LK
  timezone   String // IANA, e.g. Asia/Colombo
  vatRate    Decimal   @default(18) @db.Decimal(5, 2) // percent; copied onto each quotation line when the line is saved
  creator    User?     @relation("SettingCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdBy  String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  modifier   User?     @relation("SettingModifiedBy", fields: [modifiedBy], references: [id], onDelete: SetNull)
  modifiedBy String?
  modifiedAt DateTime? @db.Timestamptz(3)
  isDeleted  Boolean   @default(false)
}

// Where a user dropdown takes its users from: the users picked one by one, or every active user with a picked role.
enum UserDropdownSource {
  users
  roles
}

// Which users a dropdown such as "Sales manager" offers. The dropdowns are defined in code
// (modules/dropdowns/dropdowns.ts); a row is written the first time an admin saves one. Both lists are kept, so
// switching `source` back and forth doesn't lose a selection. Deactivated users never show.
model UserDropdown {
  id         String             @id // the code, e.g. SALES_MANAGER
  source     UserDropdownSource @default(roles)
  userIds    String[]           @default([])
  roleIds    String[]           @default([])
  creator    User?              @relation("UserDropdownCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdBy  String?
  createdAt  DateTime           @default(now()) @db.Timestamptz(3)
  modifier   User?              @relation("UserDropdownModifiedBy", fields: [modifiedBy], references: [id], onDelete: SetNull)
  modifiedBy String?
  modifiedAt DateTime?          @db.Timestamptz(3)
  isDeleted  Boolean            @default(false)
}

// ─── Access control ──────────────────────────────────────────────────────────
// Every user has exactly one role, and the role's permissions are the user's permissions.
// Routes require one with `config: { permission: "PRODUCTS.CREATE" }`; the codes are defined in platform/security/permissions.ts
// and synced into Permission at boot.

// Users are never deleted: "deleting" sets isDeleted = true. Ids are USER00001, USER00002, … (next_user_id() in the
// init migration). createdBy/modifiedBy hold the id of the user who made the change.
model User {
  id           String    @id @default(dbgenerated("next_user_id()"))
  email        String    @unique // stored lower-case; deactivated users keep theirs
  name         String
  passwordHash String // platform/security/password.ts; never selected unless asked for (global omit in platform/core/db.ts)
  roleId       String
  role         Role      @relation("UserRole", fields: [roleId], references: [id], onDelete: Restrict) // a role in use can't be deleted
  creator      User      @relation("UserCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction)
  createdBy    String
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  modifier     User?     @relation("UserModifiedBy", fields: [modifiedBy], references: [id], onDelete: NoAction)
  modifiedBy   String?
  modifiedAt   DateTime? @db.Timestamptz(3)
  isDeleted    Boolean   @default(false)
  sessions     Session[]

  // Rows this user created or last modified (the other side of every table's createdBy/modifiedBy).
  createdUsers                     User[]                    @relation("UserCreatedBy")
  modifiedUsers                    User[]                    @relation("UserModifiedBy")
  createdSettings                  Setting[]                 @relation("SettingCreatedBy")
  modifiedSettings                 Setting[]                 @relation("SettingModifiedBy")
  createdRoles                     Role[]                    @relation("RoleCreatedBy")
  modifiedRoles                    Role[]                    @relation("RoleModifiedBy")
  createdPermissions               Permission[]              @relation("PermissionCreatedBy")
  modifiedPermissions              Permission[]              @relation("PermissionModifiedBy")
  createdCategories                Category[]                @relation("CategoryCreatedBy")
  modifiedCategories               Category[]                @relation("CategoryModifiedBy")
  createdProducts                  Product[]                 @relation("ProductCreatedBy")
  modifiedProducts                 Product[]                 @relation("ProductModifiedBy")
  createdPriceMovements            PriceMovement[]           @relation("PriceMovementCreatedBy")
  modifiedPriceMovements           PriceMovement[]           @relation("PriceMovementModifiedBy")
  createdCostMovements             CostMovement[]            @relation("CostMovementCreatedBy")
  modifiedCostMovements            CostMovement[]            @relation("CostMovementModifiedBy")
  createdStockMovements            StockMovement[]           @relation("StockMovementCreatedBy")
  modifiedStockMovements           StockMovement[]           @relation("StockMovementModifiedBy")
  createdCustomers                 Customer[]                @relation("CustomerCreatedBy")
  modifiedCustomers                Customer[]                @relation("CustomerModifiedBy")
  createSuppliers                  Supplier[]                @relation("SupplierCreatedBy")
  modifiedSupplier                 Supplier[]                @relation("SupplierModifiedBy")
  salesManagerQuotations           Quotation[]               @relation("QuotationSalesManager")
  createdQuotations                Quotation[]               @relation("QuotationCreatedBy")
  modifiedQuotations               Quotation[]               @relation("QuotationModifiedBy")
  createdQuotationItems            QuotationItem[]           @relation("QuotationItemCreatedBy")
  modifiedQuotationItems           QuotationItem[]           @relation("QuotationItemModifiedBy")
  createdUserDropdowns             UserDropdown[]            @relation("UserDropdownCreatedBy")
  modifiedUserDropdowns            UserDropdown[]            @relation("UserDropdownModifiedBy")
  salesManagerInvoices             Invoice[]                 @relation("InvoiceSalesManager")
  finalizedInvoices                Invoice[]                 @relation("InvoiceFinalizedBy")
  cancelledInvoices                Invoice[]                 @relation("InvoiceCancelledBy")
  createdInvoices                  Invoice[]                 @relation("InvoiceCreatedBy")
  modifiedInvoices                 Invoice[]                 @relation("InvoiceModifiedBy")
  createdInvoiceItems              InvoiceItem[]             @relation("InvoiceItemCreatedBy")
  modifiedInvoiceItems             InvoiceItem[]             @relation("InvoiceItemModifiedBy")
  verifiedDeliveryNotes            DeliveryNote[]            @relation("DeliveryNoteItemVerifier")
  issuedDeliveryNotes              DeliveryNote[]            @relation("DeliveryNoteItemIssuer")
  createdDeliveryNotes             DeliveryNote[]            @relation("DeliveryNoteCreatedBy")
  modifiedDeliveryNotes            DeliveryNote[]            @relation("DeliveryNoteModifiedBy")
  cancelledInternalRequisitions    InternalRequisition[]     @relation("InternalRequisitionCancelledBy")
  createdInternalRequisitions      InternalRequisition[]     @relation("InternalRequisitionCreatedBy")
  modifiedInternalRequisitions     InternalRequisition[]     @relation("InternalRequisitionModifiedBy")
  createdInternalRequisitionItems  InternalRequisitionItem[] @relation("InternalRequisitionItemCreatedBy")
  modifiedInternalRequisitionItems InternalRequisitionItem[] @relation("InternalRequisitionItemModifiedBy")
  createdApprovalRules             ApprovalRule[]            @relation("ApprovalRuleCreatedBy")
  modifiedApprovalRules            ApprovalRule[]            @relation("ApprovalRuleModifiedBy")
  createdApprovals                 Approval[]                @relation("ApprovalCreatedBy")
  modifiedApprovals                Approval[]                @relation("ApprovalModifiedBy")

  @@index([roleId])
}

// Signed-in sessions; Redis caches them in front of this table. See platform/security/sessions.ts.
// No audit columns: a row only says a session exists.
model Session {
  id        String   @id // SHA-256 of the id in the cookie, so a leaked row can't be used to sign in
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3) // slides with activity; expired rows are deleted on the next sign-in

  @@index([userId])
  @@index([expiresAt])
}

// Ids are ROLE0001, ROLE0002, … (next_role_id(), hand-written SQL like next_user_id()).
// isSystem = Super Admin: it has every permission in code (its grant rows are ignored), its name and permissions can't
// be changed, and at least one active user always keeps it (roles.service.ts, users.service.ts).
model Role {
  id          String           @id @default(dbgenerated("next_role_id()"))
  name        String           @unique
  description String           @default("")
  isSystem    Boolean          @default(false)
  branchCode  String           @default("GP01") // the middle part of the invoice numbers its users make, 26NOV_GP01_14
  permissions RolePermission[]
  users       User[]           @relation("UserRole")
  creator     User?            @relation("RoleCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdBy   String?
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  modifier    User?            @relation("RoleModifiedBy", fields: [modifiedBy], references: [id], onDelete: SetNull)
  modifiedBy  String?
  modifiedAt  DateTime?        @db.Timestamptz(3)
  isDeleted   Boolean          @default(false)
}

// One row per (screen, permission) pair, e.g. PRODUCTS / CREATE. Rows are created from platform/security/permissions.ts at boot.
// Ids are PMSN0001, PMSN0002, … (next_permission_id(), hand-written SQL like next_user_id()).
model Permission {
  id             String           @id @default(dbgenerated("next_permission_id()"))
  screenCode     String
  permissionCode String
  description    String           @default("")
  roles          RolePermission[]
  creator        User?            @relation("PermissionCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdBy      String?
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  modifier       User?            @relation("PermissionModifiedBy", fields: [modifiedBy], references: [id], onDelete: SetNull)
  modifiedBy     String?
  modifiedAt     DateTime?        @db.Timestamptz(3)
  isDeleted      Boolean          @default(false)

  @@unique([screenCode, permissionCode])
}

// Maps roles to permissions. No audit columns: a row is the grant, and removing a grant removes the row.
// The primary key finds a role's permissions; the index finds the roles that have a permission.
model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// ─── Catalogue ───────────────────────────────────────────────────────────────

// Ids are CAT0001, CAT0002, … (next_category_id(), hand-written SQL like next_user_id()).
model Category {
  id          String    @id @default(dbgenerated("next_category_id()"))
  name        String    @unique
  description String    @default("")
  products    Product[]
  creator     User?     @relation("CategoryCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdBy   String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  modifier    User?     @relation("CategoryModifiedBy", fields: [modifiedBy], references: [id], onDelete: SetNull)
  modifiedBy  String?
  modifiedAt  DateTime? @db.Timestamptz(3)
  isDeleted   Boolean   @default(false)
}

enum TrackingType {
  quantity // counted only
  serial // every unit has its own serial number
}

// Ids are PROD000001, PROD000002, … (next_product_id(), hand-written SQL like next_user_id()).
// price, cost and the stock columns are the current values; every change to them is also recorded in PriceMovement,
// CostMovement or StockMovement (products.service.ts). isDeleted = true means deleted.
model Product {
  id                       String                    @id @default(dbgenerated("next_product_id()"))
  sku                      String                    @unique // deleted products keep theirs
  title                    String
  description              String                    @default("N/A")
  categoryId               String
  category                 Category                  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  manufacturer             String?
  countryOfOrigin          String?
  imageUrl                 String?
  documentUrl              String?
  slug                     String?
  warrantyMonths           Int
  price                    Decimal                   @default(0) @db.Decimal(14, 2)
  cost                     Decimal                   @default(0) @db.Decimal(14, 2)
  minimumStock             Int                       @default(0)
  stockInHand              Int                       @default(0)
  stockPreOrder            Int                       @default(0)
  stockInTransit           Int                       @default(0)
  stockOnArrival           Int                       @default(0)
  // Set by the database (Product_set_stock_version) from one counter for all products whenever a stock column
  // changes; never written by the app. Live stock (modules/stock) keeps the value with the higher version.
  stockVersion             BigInt                    @default(0)
  additionalInfo           String?
  trackingType             TrackingType
  priceMovements           PriceMovement[]
  costMovements            CostMovement[]
  stockMovements           StockMovement[]
  quotationItems           QuotationItem[]
  invoiceItems             InvoiceItem[]
  internalRequisitionItems InternalRequisitionItem[]
  creator                  User?                     @relation("ProductCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdBy                String?
  createdAt                DateTime                  @default(now()) @db.Timestamptz(3)
  modifier                 User?                     @relation("ProductModifiedBy", fields: [modifiedBy], references: [id], onDelete: SetNull)
  modifiedBy               String?
  modifiedAt               DateTime?                 @db.Timestamptz(3)
  isDeleted                Boolean                   @default(false)

  @@index([categoryId])
}

// Movement tables are history: one row per change, appended and never edited. A product with history can't be
// removed (Restrict); deactivate it instead.

// Selling price history.
model PriceMovement {
  id            Int       @id @default(autoincrement())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  previousPrice Decimal?  @db.Decimal(14, 2) // NULL for the first price
  price         Decimal   @db.Decimal(14, 2)
  remarks       String?
  createdBy     String?
  creator       User?     @relation("PriceMovementCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  modifiedBy    String?
  modifier      User?     @relation("PriceMovementModifiedBy", fields: [modifiedBy], references: [id], onDelete: SetNull)
  modifiedAt    DateTime? @db.Timestamptz(3)
  isDeleted     Boolean   @default(false)

  @@index([productId, createdAt])
}

// Unit cost history.
model CostMovement {
  id           Int       @id @default(autoincrement())
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  previousCost Decimal?  @db.Decimal(14, 2) // NULL for the first cost
  cost         Decimal   @db.Decimal(14, 2)
  remarks      String?
  createdBy    String?
  creator      User?     @relation("CostMovementCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  modifiedBy   String?
  modifier     User?     @relation("CostMovementModifiedBy", fields: [modifiedBy], references: [id], onDelete: SetNull)
  modifiedAt   DateTime? @db.Timestamptz(3)
  isDeleted    Boolean   @default(false)

  @@index([productId, createdAt])
}

// Which Product stock column a movement changes.
enum StockBucket {
  inHand
  preOrder
  inTransit
  onArrival
}

// Every change to a Product stock column, e.g. +10 inTransit when goods ship, then -10 inTransit / +10 inHand on arrival.
model StockMovement {
  id           Int         @id @default(autoincrement())
  productId    String
  product      Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  bucket       StockBucket
  quantity     Int // signed: + adds to the bucket, - takes from it
  balanceAfter Int // the bucket's value after this movement
  serialNumber String? // for TrackingType.serial products
  reference    String? // PLACEHOLDER: source document (GRN, invoice, adjustment no.); replace with real FKs later
  remarks      String?
  creator      User?       @relation("StockMovementCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdBy    String?
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  modifier     User?       @relation("StockMovementModifiedBy", fields: [modifiedBy], references: [id], onDelete: SetNull)
  modifiedBy   String?
  modifiedAt   DateTime?   @db.Timestamptz(3)
  isDeleted    Boolean     @default(false)

  @@index([productId, createdAt])
  @@index([serialNumber])
}

// ─── Sales ───────────────────────────────────────────────────────────────────

enum CustomerType {
  B2B
  B2C
}

// Ids are CUS000001, CUS000002, … (next_customer_id(), hand-written SQL like next_user_id()).
model Customer {
  id              String       @id @default(dbgenerated("next_customer_id()"))
  code            String
  type            CustomerType
  title           String?
  name            String
  email           String?
  phones          String[]     @default([])
  houseNumber     String?
  street          String?
  city            String?
  district        String?
  province        String?
  country         String
  contactPerson   String?
  contactPhones   String[]     @default([])
  vatNumber       String?
  tinNumber       String?
  pvNumber        String?
  isCommissioned  Boolean      @default(false) // gets special offers (large or frequent orders); flagged for sales staff, no price logic
  isActive        Boolean      @default(true) //last invoice is less than 6months
  isDormant       Boolean      @default(false) //last invoice is over 18months
  lastInvoiceDate DateTime?    @db.Timestamptz(3)
  totalInvoices   Int          @default(0) // set by the system from invoices, like isActive, isDormant and lastInvoiceDate
  notes           String?
  quotations      Quotation[]
  invoices        Invoice[]
  creator         User?        @relation("CustomerCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdBy       String?
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  modifier        User?        @relation("CustomerModifiedBy", fields: [modifiedBy], references: [id], onDelete: SetNull)
  modifiedBy      String?
  modifiedAt      DateTime?    @db.Timestamptz(3)
  isDeleted       Boolean      @default(false)

  @@index([id])
  @@index([code])
  @@index([name])
  @@index([city])
  @@index([district])
  @@index([phones], type: Gin)
  @@index([vatNumber])
  @@index([tinNumber])
}

// ─── Purchases ───────────────────────────────────────────────────────────────────

// Ids are SUP00001, SUP00002, … (next_supplier_id(), hand-written SQL like next_user_id()).
model Supplier {
  id                   String                @id @default(dbgenerated("next_supplier_id()"))
  code                 String
  name                 String
  phones               String[]              @default([])
  email                String?
  houseNumber          String?
  street               String?
  city                 String?
  district             String?
  province             String?
  country              String
  vatNumber            String?
  tinNumber            String?
  pvNumber             String?
  internalRequisitions InternalRequisition[]
  creator              User?                 @relation("SupplierCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdBy            String?
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  modifier             User?                 @relation("SupplierModifiedBy", fields: [modifiedBy], references: [id], onDelete: SetNull)
  modifiedBy           String?
  modifiedAt           DateTime?             @db.Timestamptz(3)
  isDeleted            Boolean               @default(false)

  @@index([id])
  @@index([name])
  @@index([code])
  @@index([phones], type: Gin)
  @@index([vatNumber])
}

// ─── Quotations ───────────────────────────────────────────────────────────────────

// In use now: active (every saved quotation) → cancelled | creditConfirmed | paymentConfirmed, set by users;
// cancelling a confirmed quotation stores cancelledAfterCredit | cancelledAfterPayment instead of cancelled, so it
// still shows how far it got. invoiceCreated is set by the invoice feature and locks the quotation. The other values
// are reserved for later (e.g. an approval step, which goes in its own table). Until invoiceCreated, a quotation can be
// edited and deleted.
enum QuotationStatus {
  draft
  pending
  approved
  rejected
  active
  accepted
  declined
  expired
  cancelled
  cancelledAfterCredit // cancelled when it was creditConfirmed
  cancelledAfterPayment // cancelled when it was paymentConfirmed
  creditConfirmed
  paymentConfirmed
  invoiceCreated // turned into an invoice
}

// How a line's discountValue is read. fixed = an amount off the whole line, not per unit.
enum DiscountType {
  none // discountValue must be 0
  percentage // 0–100 % of the line subtotal
  fixed // 0–subtotal
}

// What a quotation is for. Each type has its own reference fields on Quotation (null for the others), enforced by the
// CHECK constraint "Quotation_type_fields_check" (hand-written SQL, 20261105140000_quotation_types) and by the API:
//   sales    → none
//   service  → repairReceiveNoteId, oldInvoiceId, oldSerialNumberId
//   warranty → troubleshootId, oldInvoiceId, oldSerialNumberId, productModel
// How the customer pays, printed on the quotation if set. Optional.
enum QuotationPaymentTerms {
  cashOnDelivery
  advancePayment
}

enum QuotationType {
  sales
  service
  warranty
}

// Integer ids (high-volume table). The totals are the sums of the non-deleted lines, recalculated by the server
// whenever the lines change; never accepted from clients. grandTotal = subtotal − discountTotal + taxTotal.
// Was SaleQuotation until 20261105140000_quotation_types renamed it.
// NOT BUILT YET: repairReceiveNoteId, troubleshootId, oldInvoiceId and oldSerialNumberId point at modules that don't
// exist (repairs, troubleshoots, invoices, serial numbers). They are plain optional text with no foreign key; when a
// module is built, change its column to that table's id type, add the foreign key and check the id in the service.
model Quotation {
  id                  Int                    @id @default(autoincrement())
  quotationNumber     String                 @unique @default(dbgenerated("next_quotation_number()")) // GPQ-0000001, next_quotation_number(); never derived from id
  customerId          String
  customer            Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesManagerId      String
  salesManager        User                   @relation("QuotationSalesManager", fields: [salesManagerId], references: [id], onDelete: Restrict)
  quotationDate       DateTime               @db.Date
  validUntil          DateTime?              @db.Date // Can set expire date
  status              QuotationStatus        @default(active)
  subtotal            Decimal                @default(0) @db.Decimal(14, 2) // Σ line subtotal
  discountTotal       Decimal                @default(0) @db.Decimal(14, 2) // Σ line discountAmount
  taxTotal            Decimal                @default(0) @db.Decimal(14, 2) // Σ line taxAmount
  grandTotal          Decimal                @default(0) @db.Decimal(14, 2) // Σ line lineTotal
  notes               String? // internal, not printed
  terms               String? // printed on the quotation
  type                QuotationType          @default(sales)
  repairReceiveNoteId String? // service only. Repairs module not built yet: no foreign key
  troubleshootId      String? // warranty only. Troubleshoot module not built yet: no foreign key
  oldInvoiceId        String? // service and warranty. Invoices module not built yet: no foreign key
  oldSerialNumberId   String? // service and warranty. Serial numbers module not built yet: no foreign key
  productModel        String? // warranty only: typed by the user
  paymentTerms        QuotationPaymentTerms? // any type; null = not set
  deliveryLocation    String? // any type; typed by the user
  serviceCharge       Decimal?               @db.Decimal(14, 2) // service only: the price, instead of product lines
  serviceTaxRate      Decimal?               @db.Decimal(5, 2) // service only: VAT percent from the settings when the charge was saved
  isPreOrdered        Boolean                @default(false) // sales only
  items               QuotationItem[]
  invoices            Invoice[] // at most one that isn't cancelled (index "Invoice_quotationId_live_key")
  creator             User?                  @relation("QuotationCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdBy           String?
  createdAt           DateTime               @default(now()) @db.Timestamptz(3)
  modifier            User?                  @relation("QuotationModifiedBy", fields: [modifiedBy], references: [id], onDelete: SetNull)
  modifiedBy          String?
  modifiedAt          DateTime?              @db.Timestamptz(3)
  isDeleted           Boolean                @default(false)

  @@index([customerId])
  @@index([salesManagerId])
  @@index([status])
  @@index([quotationDate])
  @@index([type])
}

// One product line of a quotation. description, unitPrice, unitCost and taxRate are copied from the product and
// settings when the line is saved, so later changes to the product never alter a saved quotation. Saving new lines
// soft-deletes the old ones (isDeleted = true), so earlier versions stay in the table.
//   subtotal       = quantity × unitPrice
//   discountAmount = subtotal × discountValue / 100 (percentage) | discountValue (fixed) | 0 (none)
//   taxAmount      = (subtotal − discountAmount) × taxRate / 100
//   lineTotal      = subtotal − discountAmount + taxAmount
// All amounts are calculated by the server and rounded half-up to 2 decimals.
model QuotationItem {
  id             Int          @id @default(autoincrement())
  quotationId    Int
  quotation      Quotation    @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  lineNo         Int // display order, 1, 2, 3, …
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  description    String // product title at the time, editable per quotation
  quantity       Int // whole units, like Product stock
  unitPrice      Decimal      @db.Decimal(14, 2) // defaults to Product.price, can be changed
  unitCost       Decimal      @db.Decimal(14, 2) // Product.cost at the time; for margin, not printed
  discountType   DiscountType @default(none)
  discountValue  Decimal      @default(0) @db.Decimal(14, 2)
  taxRate        Decimal      @default(0) @db.Decimal(5, 2) // percent, e.g. 18.00
  subtotal       Decimal      @db.Decimal(14, 2)
  discountAmount Decimal      @db.Decimal(14, 2)
  taxAmount      Decimal      @db.Decimal(14, 2)
  lineTotal      Decimal      @db.Decimal(14, 2)
  creator        User?        @relation("QuotationItemCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdBy      String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  modifier       User?        @relation("QuotationItemModifiedBy", fields: [modifiedBy], references: [id], onDelete: SetNull)
  modifiedBy     String?
  modifiedAt     DateTime?    @db.Timestamptz(3)
  isDeleted      Boolean      @default(false)

  @@index([quotationId, lineNo])
  @@index([productId])
}

// ─── Invoices ───────────────────────────────────────────────────────────────────

// draft (editable, no stock moved) → finalized (numbered, stock moved inHand → inTransit). Cancelling a draft stores
// cancelled, a finalized one cancelledAfterFinalized, so the status shows how far it got. Cancelling gives the stock
// back (finalized only) and the quotation its status before the invoice.
enum InvoiceStatus {
  draft
  finalized
  cancelled // cancelled while draft
  cancelledAfterFinalized // cancelled while finalized
}

// How the customer pays. Required on sales and service invoices, optional on warranty ones (checked by the API).
enum InvoicePaymentMethod {
  cash
  credit
  cheque
  bankTransfer
}

// Integer ids (high-volume table). Made from a quotation (quotationId) or, with INVOICES.CREATE_DIRECT, without one.
// The header (customer, sales manager, type and its references, payment terms, delivery location) is copied from the
// quotation; the lines and the service charge start as the quotation's and can be repriced. The totals work like
// Quotation's: sums of the non-deleted lines, or the service charge plus VAT, always worked out by the server.
// Hand-written SQL (20261106090000_invoices): the CHECKs "Invoice_type_fields_check", "Invoice_service_charge_check",
// "Invoice_payment_details_check" and "Invoice_number_check", and the partial unique index
// "Invoice_quotationId_live_key" (one invoice that isn't cancelled per quotation).
// NOT BUILT YET: as on Quotation, the reference columns are plain text with no foreign key.
model Invoice {
  id                    Int                    @id @default(autoincrement())
  draftNumber           String                 @unique // 26NOV_GP01_3-draft: next_invoice_number('draft', …) on create
  invoiceNumber         String?                @unique // 26NOV_GP01_14: next_invoice_number('final', …) on finalize
  status                InvoiceStatus          @default(draft)
  quotationId           Int?
  quotation             Quotation?             @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  quotationStatusBefore QuotationStatus? // the quotation's status before it was invoiced; given back on cancel
  customerId            String
  customer              Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesManagerId        String
  salesManager          User                   @relation("InvoiceSalesManager", fields: [salesManagerId], references: [id], onDelete: Restrict)
  type                  QuotationType          @default(sales) // same types and rules as quotations (quotations.types.ts)
  repairReceiveNoteId   String? // service only
  troubleshootId        String? // warranty only
  oldInvoiceId          String? // service and warranty
  oldSerialNumberId     String? // service and warranty
  productModel          String? // warranty only
  paymentTerms          QuotationPaymentTerms?
  deliveryLocation      String?
  paymentMethod         InvoicePaymentMethod?
  paymentDetails        String? // cheque number and bank, or the bank of a transfer; only with those methods
  dueDate               DateTime               @db.Date
  serviceCharge         Decimal?               @db.Decimal(14, 2) // service only: the price, instead of product lines
  serviceTaxRate        Decimal?               @db.Decimal(5, 2) // service only: VAT percent when the charge was saved
  subtotal              Decimal                @default(0) @db.Decimal(14, 2)
  discountTotal         Decimal                @default(0) @db.Decimal(14, 2)
  taxTotal              Decimal                @default(0) @db.Decimal(14, 2)
  grandTotal            Decimal                @default(0) @db.Decimal(14, 2)
  notes                 String? // internal, not printed
  finalizer             User?                  @relation("InvoiceFinalizedBy", fields: [finalizedBy], references: [id], onDelete: SetNull)
  finalizedBy           String?
  finalizedAt           DateTime?              @db.Timestamptz(3) // the invoice date printed on a finalized invoice
  canceller             User?                  @relation("InvoiceCancelledBy", fields: [cancelledBy], references: [id], onDelete: SetNull)
  cancelledBy           String?
  cancelledAt           DateTime?              @db.Timestamptz(3)
  items                 InvoiceItem[]
  deliveryNote          DeliveryNote?
  creator               User?                  @relation("InvoiceCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdBy             String?
  createdAt             DateTime               @default(now()) @db.Timestamptz(3)
  modifier              User?                  @relation("InvoiceModifiedBy", fields: [modifiedBy], references: [id], onDelete: SetNull)
  modifiedBy            String?
  modifiedAt            DateTime?              @db.Timestamptz(3)
  isDeleted             Boolean                @default(false)

  @@index([quotationId])
  @@index([customerId])
  @@index([salesManagerId])
  @@index([status])
}

// One product line of an invoice: the same columns and formulas as QuotationItem. It keeps its own price and cost,
// copied from the quotation's line or the product when the line is saved, so a repriced invoice still shows what the
// quotation said. Saving new lines soft-deletes the old ones.
model InvoiceItem {
  id             Int          @id @default(autoincrement())
  invoiceId      Int
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  lineNo         Int
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  description    String
  quantity       Int
  unitPrice      Decimal      @db.Decimal(14, 2)
  unitCost       Decimal      @db.Decimal(14, 2) // Product.cost when the line was saved; for margin, not printed
  discountType   DiscountType @default(none)
  discountValue  Decimal      @default(0) @db.Decimal(14, 2)
  taxRate        Decimal      @default(0) @db.Decimal(5, 2)
  subtotal       Decimal      @db.Decimal(14, 2)
  discountAmount Decimal      @db.Decimal(14, 2)
  taxAmount      Decimal      @db.Decimal(14, 2)
  lineTotal      Decimal      @db.Decimal(14, 2)
  creator        User?        @relation("InvoiceItemCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdBy      String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  modifier       User?        @relation("InvoiceItemModifiedBy", fields: [modifiedBy], references: [id], onDelete: SetNull)
  modifiedBy     String?
  modifiedAt     DateTime?    @db.Timestamptz(3)
  isDeleted      Boolean      @default(false)

  @@index([invoiceId, lineNo])
  @@index([productId])
}

// ─── Delivery notes ─────────────────────────────────────────────────────────────

// draft (made when a sales or warranty invoice is finalized) → issued (item verifier and item issuer added).
// Cancelling the invoice cancels its note.
enum DeliveryNoteStatus {
  draft
  issued
  cancelled
}

// One per finalized invoice that has product lines (not service invoices); the products and quantities are the
// invoice's lines, so the note has none of its own. The verifier and the issuer are picked from the ITEM_VERIFIER and
// ITEM_ISSUER dropdowns (Admin → Dropdowns) and must be two different users.
// Hand-written SQL (20261109090000_delivery_notes): next_delivery_note_number() (GPDN-1, GPDN-2, … as in the old
// system), and the CHECKs "DeliveryNote_people_check" and "DeliveryNote_issued_check".
model DeliveryNote {
  id                 Int                @id @default(autoincrement())
  deliveryNoteNumber String             @unique @default(dbgenerated("next_delivery_note_number()"))
  invoiceId          Int                @unique
  invoice            Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  status             DeliveryNoteStatus @default(draft)
  itemVerifierId     String?
  itemVerifier       User?              @relation("DeliveryNoteItemVerifier", fields: [itemVerifierId], references: [id], onDelete: Restrict)
  itemIssuerId       String?
  itemIssuer         User?              @relation("DeliveryNoteItemIssuer", fields: [itemIssuerId], references: [id], onDelete: Restrict)
  issuedAt           DateTime?          @db.Timestamptz(3) // when the issuer was added
  creator            User?              @relation("DeliveryNoteCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdBy          String?
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  modifier           User?              @relation("DeliveryNoteModifiedBy", fields: [modifiedBy], references: [id], onDelete: SetNull)
  modifiedBy         String?
  modifiedAt         DateTime?          @db.Timestamptz(3)
  isDeleted          Boolean            @default(false)

  @@index([status])
  @@index([itemVerifierId])
  @@index([itemIssuerId])
}

// Document number sequences for every screen: the last value given per sequence code (invoice.draft, invoice.final),
// period (26NOV, so numbers restart every month) and branch (Role.branchCode); '' when a sequence doesn't use one.
// Written only by next_sequence_value() (hand-written SQL), never by the app; createdBy/modifiedBy stay NULL.
model NumberSequence {
  code       String
  period     String
  branch     String
  value      Int
  createdBy  String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  modifiedBy String?
  modifiedAt DateTime? @db.Timestamptz(3)
  isDeleted  Boolean   @default(false)

  @@id([code, period, branch])
}

// ─── Approvals ──────────────────────────────────────────────────────────────────
// Shared by every screen whose documents can need approval (modules/approvals). The screens are listed in code
// (APPROVAL_SCREENS in modules/approvals/approvals.ts); each keeps its own status (pending → approved | rejected) and
// calls the approvals service from its own approve and reject routes, which need <SCREEN>.APPROVE / <SCREEN>.REJECT.

// Whether a screen's documents need approval (Admin → Approvals). A row is written the first time an admin saves one;
// until then approval is required. When it isn't, a document is approved on save (an automatic Approval row).
model ApprovalRule {
  id         String    @id // the screen code, e.g. INTERNAL_REQUISITIONS
  isRequired Boolean   @default(true)
  creator    User?     @relation("ApprovalRuleCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdBy  String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  modifier   User?     @relation("ApprovalRuleModifiedBy", fields: [modifiedBy], references: [id], onDelete: SetNull)
  modifiedBy String?
  modifiedAt DateTime? @db.Timestamptz(3)
  isDeleted  Boolean   @default(false)
}

enum ApprovalDecision {
  approved
  rejected
}

// Every approve or reject decision on any document, appended and never edited, so a document rejected, resubmitted and
// approved keeps both decisions. createdBy is who decided (the user who saved it, when automatic). documentId is the
// document's id in its screen's table; there's no foreign key, since that table differs per screen.
model Approval {
  id          Int              @id @default(autoincrement())
  screen      String // the screen code, e.g. INTERNAL_REQUISITIONS
  documentId  Int
  decision    ApprovalDecision
  isAutomatic Boolean          @default(false) // approved on save because the screen didn't need approval then
  reason      String? // required when rejecting
  creator     User?            @relation("ApprovalCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdBy   String?
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  modifier    User?            @relation("ApprovalModifiedBy", fields: [modifiedBy], references: [id], onDelete: SetNull)
  modifiedBy  String?
  modifiedAt  DateTime?        @db.Timestamptz(3)
  isDeleted   Boolean          @default(false)

  @@index([screen, documentId])
}

// ─── Procurement ────────────────────────────────────────────────────────────────

// pending (editable; waiting for approval) → approved | rejected. A rejected IR can be edited and resubmitted
// (→ pending). Cancelling a pending IR stores cancelled, an approved one cancelledAfterApproved, so the status shows
// how far it got. Who approved or rejected, when and why: Approval rows (screen INTERNAL_REQUISITIONS). Purchase
// orders and GRNs have their own statuses.
enum InternalRequisitionStatus {
  pending
  approved
  rejected
  cancelled // cancelled while pending
  cancelledAfterApproved // cancelled while approved
}

// A request to buy products from one supplier; the first step of IR → purchase order → GRN. It doesn't move stock.
// The IR date is createdAt and "prepared by" is createdBy, as in the old system (date = today, preparedBy = the user).
// Hand-written SQL (migration not written yet): next_internal_requisition_number() (GPIR-0001, GPIR-0002, … as in the
// old system).
model InternalRequisition {
  id                        Int                       @id @default(autoincrement())
  internalRequisitionNumber String                    @unique @default(dbgenerated("next_internal_requisition_number()"))
  supplierId                String
  supplier                  Supplier                  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status                    InternalRequisitionStatus @default(pending)
  isInternational           Boolean                   @default(false) // no purchase order: the GRN is made from the IR
  eta                       DateTime?                 @db.Date // expected arrival; can be changed while pending
  cancelReason              String?
  canceller                 User?                     @relation("InternalRequisitionCancelledBy", fields: [cancelledBy], references: [id], onDelete: SetNull)
  cancelledBy               String?
  cancelledAt               DateTime?                 @db.Timestamptz(3)
  items                     InternalRequisitionItem[]
  creator                   User?                     @relation("InternalRequisitionCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdBy                 String?
  createdAt                 DateTime                  @default(now()) @db.Timestamptz(3)
  modifier                  User?                     @relation("InternalRequisitionModifiedBy", fields: [modifiedBy], references: [id], onDelete: SetNull)
  modifiedBy                String?
  modifiedAt                DateTime?                 @db.Timestamptz(3)
  isDeleted                 Boolean                   @default(false)

  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
}

// One product line of an internal requisition. stockInHand and minimumStock are copied from the product when the line
// is saved, so the IR still shows what the requester saw (the old "Available Qty" and "MOQ"). Saving new lines
// soft-deletes the old ones, as on InvoiceItem.
model InternalRequisitionItem {
  id                    Int                 @id @default(autoincrement())
  internalRequisitionId Int
  internalRequisition   InternalRequisition @relation(fields: [internalRequisitionId], references: [id], onDelete: Restrict)
  lineNo                Int // display order, 1, 2, 3, …
  productId             String
  product               Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity              Int // the order quantity, whole units, at least 1
  stockInHand           Int // Product.stockInHand at the time
  minimumStock          Int // Product.minimumStock at the time
  creator               User?               @relation("InternalRequisitionItemCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdBy             String?
  createdAt             DateTime            @default(now()) @db.Timestamptz(3)
  modifier              User?               @relation("InternalRequisitionItemModifiedBy", fields: [modifiedBy], references: [id], onDelete: SetNull)
  modifiedBy            String?
  modifiedAt            DateTime?           @db.Timestamptz(3)
  isDeleted             Boolean             @default(false)

  @@index([internalRequisitionId, lineNo])
  @@index([productId])
}
