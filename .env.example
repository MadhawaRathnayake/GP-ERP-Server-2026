# --- Infrastructure (read once at boot, validated in src/config/env.ts) ---
NODE_ENV=development
# development | staging | production. API docs (/docs) are served everywhere except production.
APP_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug
# PLACEHOLDER: your local Postgres user/password (the default postgres/postgres was rejected on this machine)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gp_erp
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:5173
# Log every SQL query with its duration
PRISMA_LOG_QUERIES=false
# Safety-net expiry for cached entries; normal invalidation is event-driven
CACHE_TTL_SECONDS=3600

# --- Sessions (cookie holds a random id; data lives in Redis) ---
SESSION_COOKIE_NAME=sid
# 8 hours of inactivity
SESSION_TTL_SECONDS=28800
# lax when frontend + API share a site; none (with COOKIE_SECURE=true) for different sites
COOKIE_SAMESITE=lax
# PLACEHOLDER: must be true in production (HTTPS)
COOKIE_SECURE=false

# --- Defaults for business settings (only used to create the first Setting row) ---
DEFAULT_CURRENCY=LKR
DEFAULT_COUNTRY=LK
DEFAULT_TIMEZONE=Asia/Colombo

# --- Seed only (npm run db:seed) — PLACEHOLDER: first admin login ---
SEED_ADMIN_EMAIL=admin@gp-erp.local
SEED_ADMIN_PASSWORD=change-me-now
